VITE_APP_VERSION=0.1.0
# Desktop app OAuth client — no client_secret needed (optional for installed apps per Google docs).
# Get this from Google Cloud Console → Credentials → your OAuth 2.0 Client ID (Desktop app type).
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Must include the Vite base path (set in vite.config.ts → base).
# For local dev with base '/zentro/':  http://localhost:5173/zentro/oauth/callback
# For production with base '/zentro/': https://your-domain.com/zentro/oauth/callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/zentro/oauth/callback
